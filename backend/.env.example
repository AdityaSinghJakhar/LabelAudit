# Single-database fallback. Used only when DATABASE_SHARD_URLS is empty --
# convenient for a solo dev running one local Postgres.
DATABASE_URL=postgresql+psycopg://labelaudit:labelaudit@localhost:5432/labelaudit

# Comma-separated Postgres URLs, one per shard. When set, this takes
# priority over DATABASE_URL. Every shard needs the same schema -- run
# `python -m scripts.migrate_shards` after adding one, rather than
# alembic directly (see that script's docstring for why).
DATABASE_SHARD_URLS=postgresql+psycopg://labelaudit:labelaudit@localhost:5432/labelaudit_0,postgresql+psycopg://labelaudit:labelaudit@localhost:5433/labelaudit_1

# Change this in any environment beyond local development.
AUTH_SECRET_KEY=dev-secret-change-me

# Below this mean OCR token confidence, presence checks report
# NOT_ASSESSABLE instead of FAIL. See app/services/rules_service.py.
MIN_OCR_CONFIDENCE_FOR_VERDICT=0.55
